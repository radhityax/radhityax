separator=true
separator_block_width=15
markup=pango

[wifi]
label=
command=nmcli -t -f active,ssid dev wifi | grep '^yes' | cut -d: -f2
interval=5
color=#ffffff

[net_speed]
command=/home/radhitya/.config/i3blocks/scripts/net_speed.sh
interval=1
color=#ffffff

[memory]
label=
command=free -g | awk '/^Mem:/ {print $3 "G/" $2 "G"}'
interval=5
color=#ffffff

[cpu_usage]
label=
command=grep 'cpu ' /proc/stat | awk '{usage=($2+$4)*100/($2+$4+$5)} END {printf "%02.1f%%\n", usage}'
interval=2
color=#ffffff

[temp]
label=
command=sensors | grep 'Core 0' | awk '{print $3}'
interval=5
color=#ffffff

[volume]
label=
command=case $BLOCK_BUTTON in 1) pactl set-sink-mute @DEFAULT_SINK@ toggle ;; 4) pactl set-sink-volume @DEFAULT_SINK@ +5%; [ $(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po "[0-9]+(?=%)" | head -1) -gt 100 ] && pactl set-sink-volume @DEFAULT_SINK@ 100% ;; 5) pactl set-sink-volume @DEFAULT_SINK@ -5% ;; esac; pactl get-sink-mute @DEFAULT_SINK@ | grep -q "yes" && echo " MUTE" || pactl get-sink-volume @DEFAULT_SINK@ | grep -Po "[0-9]+(?=%)" | head -1 | awk '{print $1 "%"}'
interval=1
signal=1
color=#ffffff

[battery]
command=status=$(cat /sys/class/power_supply/AC/online); percent=$(cat /sys/class/power_supply/BAT0/capacity); if [ "$status" = "1" ]; then echo " $percent%"; else echo " $percent%"; fi
interval=5
color=#ffffff

[bluetooth]
label=
command=bluetoothctl devices Connected | cut -d ' ' -f 3- | head -1
interval=10
color=#ffffff

[uptime]
label=
command=uptime -p | sed 's/up //; s/ days\?, /d /; s/ hours\?, /h /; s/ minutes\?/m/'
interval=60
color=#ffffff

[time]
label=
command=date '+%Y-%m-%d %H:%M'
interval=60
color=#ffffff
